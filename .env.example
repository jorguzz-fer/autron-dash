# ─── Banco de dados ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://autron:autron@localhost:5432/autron_dash?schema=public"

# ─── Auth.js v5 ────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# ─── Tenant inicial (criado pelo seed) ─────────────────────────────────────
SEED_ADMIN_EMAIL="fer.jorge@gmail.com"
SEED_ADMIN_NAME="Fernando Jorge"
SEED_ADMIN_PASSWORD="change-me-on-first-login"
SEED_TENANT_NAME="Autron"
SEED_TENANT_SLUG="autron"

# ─── Upload de planilhas ───────────────────────────────────────────────────
# Pasta no servidor onde os arquivos enviados ficam armazenados
UPLOADS_DIR="./uploads"
MAX_UPLOAD_SIZE_MB="20"
