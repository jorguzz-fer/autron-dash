# ─── Banco de dados ────────────────────────────────────────────────────────
DATABASE_URL="postgresql://autron:autron@localhost:5432/autron_dash?schema=public"

# ─── Auth.js v5 ────────────────────────────────────────────────────────────
# Gere com: openssl rand -base64 32
AUTH_SECRET="change-me-in-production"
AUTH_TRUST_HOST="true"
NEXTAUTH_URL="http://localhost:3000"

# ─── MFA (verificação em duas etapas / TOTP) ───────────────────────────────
# Chave usada para cifrar o segredo TOTP em repouso (AES-256-GCM). Opcional:
# se ausente, é derivada de AUTH_SECRET. Defina uma chave dedicada (e estável!)
# em produção — trocá-la invalida os segredos MFA já cadastrados, forçando
# todos os usuários a reconfigurar o app autenticador.
# Gere com: openssl rand -base64 32
# MFA_ENCRYPTION_KEY="change-me-in-production"

# ─── Tenant inicial (criado pelo seed) ─────────────────────────────────────
SEED_ADMIN_EMAIL="fer.jorge@gmail.com"
SEED_ADMIN_NAME="Fernando Jorge"
SEED_ADMIN_PASSWORD="change-me-on-first-login"
SEED_TENANT_NAME="Autron"
SEED_TENANT_SLUG="autron"

# ─── Upload de planilhas ───────────────────────────────────────────────────
# Pasta no servidor onde os arquivos enviados ficam armazenados
UPLOADS_DIR="./uploads"
MAX_UPLOAD_SIZE_MB="20"

# ─── Enriquecimento de CNPJ ────────────────────────────────────────────────
# Ordem dos provedores (1º = preferido). Default: "brasilapi,receitaws".
# BrasilAPI é gratuita e não precisa de chave. Adicione "b2b" para o provedor
# pago da fase 2 (decisores/contatos) — só entra na cadeia se as duas vars
# CNPJ_B2B_API_URL e CNPJ_B2B_API_KEY estiverem preenchidas.
CNPJ_ENRICH_PROVIDERS="brasilapi,receitaws"
# ReceitaWS: token opcional (tier pago / v2). Sem token usa o free (3 req/min).
RECEITAWS_TOKEN=""
# Provedor B2B pago (fase 2 — Camadas 2/3/4). Vazio = desabilitado.
CNPJ_B2B_API_URL=""
CNPJ_B2B_API_KEY=""
# Throttle (ms) por provedor — respeita o rate limit das APIs externas.
CNPJ_BRASILAPI_MIN_INTERVAL_MS="250"
CNPJ_RECEITAWS_MIN_INTERVAL_MS="21000"
# Tentativas máximas por registro antes de ficar ERROR definitivo.
CNPJ_ENRICH_MAX_ATTEMPTS="3"
# ── Inscrições Estaduais (IE) via ReceitaWS CCC — enriquecimento OPCIONAL ──
# Cobrado por consulta; usa o RECEITAWS_TOKEN acima. Retorna a IE de todos os
# estados numa só chamada. Ligue com "true" para habilitar.
CNPJ_ENRICH_IE="false"
# Defasagem máxima aceita (dias). Valor alto prefere o cache da ReceitaWS
# (mais barato/rápido). Default: 365.
CNPJ_IE_DAYS="365"
# Throttle (ms) da consulta de IE. Ajuste conforme o plano/limite do token.
CNPJ_RECEITAWS_CCC_MIN_INTERVAL_MS="1500"
# Timeout (ms) da consulta de IE (pode ser mais lenta que o CNPJ). Default: 30000.
CNPJ_IE_TIMEOUT_MS="30000"
