generator client {
  provider   = "prisma-client-js"
  // engineType = "library": usa o query engine empacotado no @prisma/client
  // (WASM/lib), sem baixar/carregar o binário nativo (~200MB) durante o
  // `prisma generate`. Libera memória do container de build no Coolify —
  // o `next build` estava sendo morto por OOM (exit 255) na VPS.
  engineType = "library"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Multi-tenant ────────────────────────────────────────────────────────────

model Tenant {
  id        String   @id @default(cuid())
  slug      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users                 User[]
  auditLogs             AuditLog[]
  pedidos               Pedido[]
  followUps             FollowUp[]
  estoques              Estoque[]
  faturamentos          Faturamento[]
  classificacoesProduto ClassificacaoProduto[]
  metas                 Meta[]
  ploomesOportunidades  PloomesOportunidade[]
  dataUploads           DataUpload[]
  prazosEngenhariaIND21 PrazoEngenhariaIND21[]
  conciliacoes          Conciliacao[]
  comissaoCargos        ComissaoCargo[]
  comissaoVendedores    ComissaoVendedor[]
  comissaoLancamentos   ComissaoLancamento[]
  comissaoMetas         ComissaoMeta[]
  observacoesPV         ObservacaoPV[]
}

// ─── Auth ────────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  tenantId           String
  name               String
  email              String
  passwordHash       String
  role               Role      @default(VIEWER)
  active             Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  lastLoginAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  tenant                Tenant                 @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sessions              Session[]
  auditLogs             AuditLog[]
  dataUploads           DataUpload[]
  prazosEngenhariaIND21 PrazoEngenhariaIND21[]
  conciliacoes          Conciliacao[]
  observacoesPV         ObservacaoPV[]

  @@unique([tenantId, email])
  @@index([email])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  ip        String?
  userAgent String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

enum Role {
  ADMIN
  DIRETOR
  GERENTE
  OPERADOR
  VIEWER
  CONTROLADORIA
}

// ─── Auditoria & segurança ──────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(cuid())
  tenantId  String?
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId, createdAt])
  @@index([userId, createdAt])
  @@index([entity, entityId])
}

model RateLimitHit {
  id    Int      @id @default(autoincrement())
  key   String
  hitAt DateTime @default(now())

  @@index([key, hitAt])
}

// ─── LGPD ───────────────────────────────────────────────────────────────────

model LGPDConsent {
  id        String   @id @default(cuid())
  userId    String
  version   String
  accepted  Boolean
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

// ─── Datasets de domínio (Protheus) ─────────────────────────────────────────
// Estratégia: snapshot atual. Cada upload do mesmo dataset substitui os dados.
// Histórico do upload em si (quem, quando, hash, linhas) fica em DataUpload.

enum Dataset {
  PEDIDO
  FOLLOWUP
  ESTOQUE
  FATURAMENTO
  CLASSIFICACAO
  META
  PLOOMES
  COMISSAO_ANALITICO
  COMISSAO_META
}

enum MetaCategoria {
  ENTRADA_PEDIDO
  RECEITA
}

enum UploadStatus {
  PROCESSING
  SUCCESS
  FAILED
}

model DataUpload {
  id           String       @id @default(cuid())
  tenantId     String
  userId       String
  dataset      Dataset
  filename     String
  fileHash     String
  fileSize     Int
  rowCount     Int          @default(0)
  status       UploadStatus @default(PROCESSING)
  errorMessage String?
  startedAt    DateTime     @default(now())
  finishedAt   DateTime?

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([tenantId, dataset, startedAt(sort: Desc)])
  @@index([fileHash])
}

// ── 1. Pedido (entrada_pedido.xlsx) ────────────────────────────────────────
model Pedido {
  id               String    @id @default(cuid())
  tenantId         String
  numPedido        String // PV — pode ter prefixo 'I'/'B' (filtramos no parser)
  item             Int
  produto          String
  descricaoProduto String?
  quantidade       Int
  vlrTotal         Decimal?  @db.Decimal(15, 2)
  margemPct        Decimal?  @db.Decimal(8, 4)
  dtEmissao        DateTime?
  dtEntrega        DateTime? // coluna "Entrega" do relatório entrada pedido (= data faturamento prevista)
  dtOfertada       DateTime?
  dtFatCli         DateTime?
  notaFiscal       Int? // null = EM ABERTO; preenchido = FINALIZADO
  numeroSC         String? // armazenado como string para evitar perda de precisão
  itemSC           Int?
  numeroOP         String?
  itemOP           Int?
  pedCliente       String?
  nomeVendedor     String?
  unidadeNegocio   String?
  contrato         Boolean   @default(false)
  cliente          String?
  createdAt        DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, numPedido, item])
  @@index([tenantId, dtEmissao])
  @@index([tenantId, produto])
  @@index([tenantId, numeroSC])
  @@index([tenantId, notaFiscal])
}

// ── 2. FollowUp (followup.xlsx) ────────────────────────────────────────────
model FollowUp {
  id              String    @id @default(cuid())
  tenantId        String
  noSC            String // No. da S.C.
  numeroPV        String?
  codigoItem      String?
  pasta           String? // "17/04 a 23/04" — semana de entrega
  dtConfirma      DateTime?
  dtPreEntr       DateTime?
  dtChegadaAutron DateTime?
  noPO            String?
  opNaSC          String? // OP referenciada na SC (string p/ preservar precisão)
  pvInformadoSC   String?
  createdAt       DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, noSC])
  @@index([tenantId, numeroPV, codigoItem])
  @@index([tenantId, dtConfirma])
}

// ── 3. Estoque (mata010.xlsx) ──────────────────────────────────────────────
model Estoque {
  id           String   @id @default(cuid())
  tenantId     String
  codigo       String // código do produto
  saldoEstoque Decimal  @db.Decimal(15, 4)
  createdAt    DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, codigo])
  @@index([tenantId, saldoEstoque])
}

// ── 4. Faturamento (faturamento.xlsx) ──────────────────────────────────────
model Faturamento {
  id                 String    @id @default(cuid())
  tenantId           String
  emissao            DateTime?
  numDocto           String // NF (string p/ preservar zeros à esquerda)
  produto            String
  descricaoProduto   String?
  quantidade         Int
  vlrUnitario        Decimal?  @db.Decimal(15, 4)
  vlrBruto           Decimal?  @db.Decimal(15, 2)
  vlrIcms            Decimal?  @db.Decimal(15, 2)
  vlrIpi             Decimal?  @db.Decimal(15, 2)
  noPedido           String? // PV
  itemPv             Int?
  faturamentoBruto   Decimal?  @db.Decimal(15, 2)
  faturamentoLiquido Decimal?  @db.Decimal(15, 2)
  margemLiquidaR     Decimal?  @db.Decimal(15, 2)
  margemLiquidaPct   Decimal?  @db.Decimal(8, 4)
  nomeVendedor       String?
  razaoSocial        String?
  nomeFantasia       String?
  uf                 String?
  tipoNegocio        String?
  createdAt          DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // SEM @@unique: faturamento NÃO é único por (numDocto, produto, itemPv).
  // A mesma NF tem o mesmo produto+item em várias linhas (filiais, lotes,
  // remessas parciais). Streamlit trata como lista plana e soma tudo
  // (app.py:2089). O @@unique antigo forçava o parser a deduplicar,
  // perdendo ~R$ 5,9M de receita (320 colisões reais).
  @@index([tenantId, numDocto])
  @@index([tenantId, emissao])
  @@index([tenantId, noPedido])
  @@index([tenantId, nomeVendedor])
}

// ── 5. ClassificacaoProduto (sciozvs0.csv) ─────────────────────────────────
model ClassificacaoProduto {
  id          String   @id @default(cuid())
  tenantId    String
  produto     String
  tipoProduto String // "Comprando" | "Produzindo" | "Indefinido"
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, produto])
  @@index([tenantId, tipoProduto])
}

// ── 6. Meta (Metas_Budget_Grupo_Autron_<ano>.xlsx) ─────────────────────────
// Layout: 3 blocos (AUTRON / ERGOMEC / GRUPO), cada um com várias linhas-categoria
// (Entrada de pedido, Receita de vendas e Serviços, sub-itens) × 12 meses.
// GRUPO = fórmula AUTRON+ERGOMEC; o parser pega o resultado calculado.
model Meta {
  id        String        @id @default(cuid())
  tenantId  String
  unidade   String        // "AUTRON" | "ERGOMEC" | "GRUPO"
  categoria MetaCategoria
  ano       Int
  mes       Int           // 1..12
  valor     Decimal       @db.Decimal(15, 2)
  createdAt DateTime      @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, unidade, categoria, ano, mes])
  @@index([tenantId, ano, categoria])
}

// ── 7. PloomesOportunidade (Ganhas.xlsx — export do CRM Ploomes) ──────────
// Cada linha = 1 oportunidade ganha no CRM. Cruzamento com Pedido via
// "Número do Pedido de Compra do cliente" (= Pedido.pedCliente).
model PloomesOportunidade {
  id                  String    @id @default(cuid())
  tenantId            String
  ploomesId           String
  titulo              String
  codigoCliente       String?
  cliente             String?
  responsavel         String?
  valor               Decimal?  @db.Decimal(15, 2)
  termino             DateTime? // quando a oportunidade foi GANHA
  criacao             DateTime? // quando foi criada no CRM
  marcadores          String?
  cidadeCliente       String?
  ufCliente           String?
  emailContato        String?
  pedidoCompraCliente String?   // chave de cruzamento com Pedido.pedCliente
  createdAt           DateTime  @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, ploomesId])
  @@index([tenantId, termino])
  @@index([tenantId, pedidoCompraCliente])
  @@index([tenantId, responsavel])
}

// ── 8. PrazoEngenhariaIND21 — Controle interno Ergomec ─────────────────────
// Pedidos da unidade IND21 (Ergomec) têm prazo de entrega definido em reuniões
// semanais com engenharia. Cada atualização vira um registro novo (audit-trail
// por design): "prazo atual" = registro mais recente; histórico = lista
// completa por (tenantId, numPedido) ordenada por criadoEm DESC.
// Granularidade: por PV (numPedido), não por item — já que engenharia
// define um prazo único para o pedido inteiro.
model PrazoEngenhariaIND21 {
  id         String   @id @default(cuid())
  tenantId   String
  numPedido  String
  dataPrazo  DateTime
  observacao String?
  criadoPor  String
  criadoEm   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [criadoPor], references: [id], onDelete: Restrict)

  @@index([tenantId, numPedido, criadoEm(sort: Desc)])
  @@index([tenantId, criadoEm])
}

// ── 8b. ObservacaoPV — Observações gerais por PV (Prontidão) ───────────────
// Texto livre por pedido (numPedido) visível nas tabelas de Prontidão (lista
// geral + Ergomec). Diferente do PrazoEngenhariaIND21, aqui NÃO há histórico:
// um único registro por (tenantId, numPedido), atualizado in-place via upsert.
// `atualizadoEm` (@updatedAt) e `atualizadoPor` registram quem mexeu por último.
// Granularidade por PV (não por item) — a observação vale pro pedido inteiro.
model ObservacaoPV {
  id            String   @id @default(cuid())
  tenantId      String
  numPedido     String
  texto         String
  atualizadoPor String
  atualizadoEm  DateTime @default(now()) @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [atualizadoPor], references: [id], onDelete: Restrict)

  @@unique([tenantId, numPedido])
  @@index([tenantId])
}

// ── 9. Conciliação Financeiro × Contábil ───────────────────────────────────
// Módulo da Controladoria: compara duas planilhas extraídas do Protheus —
// Relatório Financeiro (posição de títulos a receber) e Balancete Contábil
// (lançamentos por conta) — e identifica divergências por número de NF.
//
// Acesso restrito a usuários com role CONTROLADORIA (ou ADMIN). Multi-tenant
// via tenantId em toda query (mesma regra das outras entidades do app).
//
// Os arquivos originais são armazenados em Bytes (~30KB cada) para auditoria
// e re-processamento — caso o algoritmo seja refinado, podemos rodar de novo
// sobre os mesmos uploads.

enum ConciliacaoStatus {
  RASCUNHO     // criada mas ainda não processada
  OK           // sem divergências (totais bateram)
  DIVERGENTE   // ao menos 1 divergência encontrada
}

enum DivergenciaLado {
  SO_FINANCEIRO   // NF presente só no relatório financeiro
  SO_CONTABIL     // NF presente só no balancete contábil
  DIVERGENTE      // NF em ambos, mas saldos diferentes
  NF_ANTERIOR     // NF emitida em período ANTERIOR ao contábil — contábil só tem o recebimento (saldo negativo)
}

model Conciliacao {
  id              String   @id @default(cuid())
  tenantId        String
  userId          String                                    // quem criou
  contaContabil   String                                    // "1121010001" ou "1.1.2.10.1"
  descricaoConta  String?                                   // "Clientes Nacionais"
  dataReferencia  DateTime                                  // dia do fechamento (ex: 31/03/2026)

  financeiroFileName String
  financeiroBlob     Bytes                                  // arquivo original
  contabilFileName   String
  contabilBlob       Bytes

  totalFinanceiro Decimal @db.Decimal(15, 2)
  totalContabil   Decimal @db.Decimal(15, 2)
  diferencaTotal  Decimal @db.Decimal(15, 2)
  qtdDivergencias Int

  observacoes String?
  status      ConciliacaoStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant       Tenant                   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user         User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  divergencias ConciliacaoDivergencia[]

  @@index([tenantId, dataReferencia(sort: Desc)])
  @@index([tenantId, contaContabil])
  @@index([tenantId, status])
}

model ConciliacaoDivergencia {
  id              String          @id @default(cuid())
  conciliacaoId   String
  numeroNF        String                                       // "32433" (sem zeros à esquerda)
  codigoCliente   String?                                      // "C000297" (quando vier do financeiro)
  nomeCliente     String?                                      // "3M - SUMARE"
  // Parcelas conhecidas no FINANCEIRO pra essa NF. String descritiva tipo
  // "1, 2, 3 (3 parcelas)" ou "única" (= título não parcelado). Vem agregada
  // do domínio porque cada NF pode aparecer em múltiplas linhas do financeiro.
  // Null quando a NF não está no financeiro (lado = SO_CONTABIL).
  parcelas        String?
  lado            DivergenciaLado
  saldoFinanceiro Decimal?        @db.Decimal(15, 2)
  saldoContabil   Decimal?        @db.Decimal(15, 2)
  diferenca       Decimal?        @db.Decimal(15, 2)           // financeiro - contábil

  conciliacao Conciliacao @relation(fields: [conciliacaoId], references: [id], onDelete: Cascade)

  @@index([conciliacaoId, lado])
}

// ── 10. Comissões ─────────────────────────────────────────────────────────────

enum ComissaoClassificacao {
  PREVISTO
  FATURADO
  PAGO
}

model ComissaoCargo {
  id          String   @id @default(cuid())
  tenantId    String
  ano         Int
  cargo       String
  comissaoPct Decimal  @db.Decimal(6, 4)
  gatilhoPct  Decimal  @db.Decimal(6, 4)
  base        String   // "INDIVIDUAL" | "COLETIVO" | "CARTEIRA"
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, ano, cargo])
}

model ComissaoVendedor {
  id              String   @id @default(cuid())
  tenantId        String
  codigoProtheus  String
  nome            String
  cargo           String
  tipo            String   // "CLT" | "PJ" | "REPRESENTANTE"
  nivel           Int?
  gatilhoOverride Decimal? @db.Decimal(6, 4)
  ativo           Boolean  @default(true)
  createdAt       DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, codigoProtheus])
}

model ComissaoLancamento {
  id                String                @id @default(cuid())
  tenantId          String
  numeroPedido      String
  itemPedido        String?
  dataEmissao       DateTime
  codCliente        String?
  cliente           String?
  produto           String?
  quantidade        Int?
  valor             Decimal               @db.Decimal(15, 2)
  codVendedor       String
  tipoNegocio       String?
  dataEntrega       DateTime?
  dataVencimento    DateTime?
  dataPagamento     DateTime?
  condicaoPagamento String?
  parcela           Int?
  pctRateio         Decimal               @db.Decimal(8, 4)
  classificacao     ComissaoClassificacao
  createdAt         DateTime              @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId, codVendedor, dataEmissao])
  @@index([tenantId, classificacao])
  @@index([tenantId, dataPagamento])
}

model ComissaoMeta {
  id          String   @id @default(cuid())
  tenantId    String
  codVendedor String
  ano         Int
  mes         Int
  valorMeta   Decimal  @db.Decimal(15, 2)
  createdAt   DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, codVendedor, ano, mes])
}
